{
  "nodeVersion": "18",
  "outputDirectory": ".",
  "cloudFunctions": {
    "nodejs": {
      "/api/accounts": {
        "path": "/api/accounts",
        "entry": "api/accounts.js"
      },
      "/api/files": {
        "path": "/api/files",
        "entry": "api/files.js"
      },
      "/api/deploy": {
        "path": "/api/deploy",
        "entry": "api/deploy.js"
      },
      "/host": {
        "path": "/host",
        "entry": "host/[[default]].js"
      }
    }
  }
}
