{
  "nodeVersion": "18",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cloudFunctions": {
    "nodejs": {
      "/api/vpn/connect": {
        "path": "/api/vpn/connect",
        "entry": "api/vpn/connect.js"
      },
      "/api/vpn/countries": {
        "path": "/api/vpn/countries",
        "entry": "api/vpn/countries.js"
      },
      "/api/vpn/disconnect": {
        "path": "/api/vpn/disconnect",
        "entry": "api/vpn/disconnect.js"
      },
      "/api/stripe/create-subscription": {
        "path": "/api/stripe/create-subscription",
        "entry": "api/stripe/create-subscription.js"
      }
    }
  }
}
