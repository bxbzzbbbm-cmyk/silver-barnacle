{
  "installCommand": "npm install",
  "outputDirectory": ".",
  "nodeVersion": "18",
  "cloudFunctions": {
    "nodejs": {
      "api/vpn/connect": {
        "handler": "cloud-functions/api/vpn/connect.js"
      },
      "api/vpn/disconnect": {
        "handler": "cloud-functions/api/vpn/disconnect.js"
      },
      "api/vpn/country": {
        "handler": "cloud-functions/api/vpn/country.js"
      }
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/src/vpn.html" }
  ],
  "caches": [
    {
      "source": "/api/vpn/country",
      "cacheTtl": 300
    }
  ],
  "headers": [
    {
      "source": "/api/vpn/*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
